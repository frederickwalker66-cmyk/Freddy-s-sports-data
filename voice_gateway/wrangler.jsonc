{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "freddys-v9-private-voice",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [{
    "name": "VOICE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}
